def discovered_law(positions, velocities, duration, **params):
    import numpy as np
    from scipy.integrate import solve_ivp
    p = np.asarray(positions, dtype=float)
    v = np.asarray(velocities, dtype=float)
    n = len(p)
    nb = n - 5
    G = params.get("G", 0.15)
    s1 = params.get("s1", 3.0)
    s2 = params.get("s2", -2.0)
    source = np.ones(nb)
    source[nb//3:2*nb//3] = s1
    source[2*nb//3:] = s2
    y0 = np.concatenate((p.ravel(), v.ravel()))
    def rhs(t, y):
        x = y[:2*n].reshape(n, 2)
        u = y[2*n:].reshape(n, 2)
        d = x[:nb][None, :, :] - x[:, None, :]
        r2 = np.sum(d*d, axis=2) + 0.0025
        if nb:
            r2[np.arange(nb), np.arange(nb)] = np.inf
        a = G * np.sum(source[None, :, None] * d / r2[:, :, None], axis=1)
        return np.concatenate((u.ravel(), a.ravel()))
    sol = solve_ivp(rhs, (0.0, duration), y0, method="RK45", rtol=1e-6, atol=1e-7)
    return sol.y[:2*n, -1].reshape(n, 2).tolist()

def fit_parameters():
    return {
        "G": {"init": 0.15, "bounds": [0.12, 0.18]},
        "s1": {"init": 3.0, "bounds": [2.5, 3.5]},
        "s2": {"init": -2.0, "bounds": [-2.5, -1.5]}
    }
