<run_mse_fit>
def discovered_law(positions, velocities, duration, **params):
    import numpy as np
    from scipy.integrate import solve_ivp
    p = np.asarray(positions, dtype=float)
    v = np.asarray(velocities, dtype=float)
    n = len(p)
    nb = n - 5
    G = params.get("G", 0.6)
    exponent = params.get("exponent", 1.86)
    q1 = params.get("q1", 1.0)
    q2 = params.get("q2", 1.0)
    qb = np.ones(nb)
    qb[np.arange(nb) % 3 == 1] = q1
    qb[np.arange(nb) % 3 == 2] = q2
    response = np.concatenate((qb, np.ones(5)))
    y0 = np.concatenate((p.ravel(), v.ravel()))
    def rhs(t, y):
        x = y[:2*n].reshape(n, 2)
        u = y[2*n:].reshape(n, 2)
        d = x[:nb][None, :, :] - x[:, None, :]
        r2 = np.sum(d*d, axis=2) + 0.49
        if nb:
            r2[np.arange(nb), np.arange(nb)] = np.inf
        field = np.sum(qb[None, :, None] * d / r2[:, :, None]**((exponent + 1.0)/2.0), axis=1)
        a = G * response[:, None] * field
        return np.concatenate((u.ravel(), a.ravel()))
    sol = solve_ivp(rhs, (0.0, duration), y0, method="RK45", rtol=1e-4, atol=1e-4)
    return sol.y[:2*n, -1].reshape(n, 2).tolist()

def fit_parameters():
    return {
        "G": {"init": 0.6, "bounds": [0.001, 3.0]},
        "exponent": {"init": 1.86, "bounds": [0.2, 4.0]},
        "q1": {"init": 1.0, "bounds": [-3.0, 3.0]},
        "q2": {"init": 1.0, "bounds": [-3.0, 3.0]}
    }
</run_mse_fit>
